NODE_ENV=development
PORT=8080
PUBLIC_API_URL=http://localhost:8080
FRONTEND_ORIGINS=https://naija-design-flow.base44.app,http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/naijadesign
DATABASE_SSL=false
DB_POOL_MAX=10

# Auth: configure to match the JWT issuer used by your Base44 integration.
# The public Base44 URL alone does not reveal the issuer/audience.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ROLE_CLAIM=role
AUTH_ADMIN_ROLES=admin,superadmin
# For local development only. Do not enable in production.
DEV_AUTH_ENABLED=false

# Paystack secret key is server-only. Start with a test secret key.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_IP_ALLOWLIST=
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=https://naija-design-flow.base44.app/payment-result

# AI provider: gemini | openai | custom
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_OUTPUT_BYTES=15000000

# Image storage: local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=900

# Tokens and operations (internal credits; not cryptocurrency)
DEFAULT_SIGNUP_TOKENS=10
TOKEN_COST_STANDARD=5
TOKEN_COST_HIGH_QUALITY=10
TOKEN_COST_EDIT=4
TOKEN_COST_VARIATION=3
REFERRAL_REFERRER_TOKENS=25
REFERRAL_NEW_USER_TOKENS=10
REFERRAL_MIN_PURCHASE_KOBO=100000
REFERRAL_REWARD_MAX_PER_USER=100
MAX_PROMPT_CHARS=5000
MAX_UPLOAD_BYTES=10000000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
